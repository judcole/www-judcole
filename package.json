{
    "name": "jc-portfolio",
    "version": "3.0.0",
    "description": "Jud Cole Personal Portfolio Website",
    "type": "module",
    "scripts": {
        "astro": "astro",
        "build": "astro build",
        "check": "eslint . && astro check && tsc --project tsconfig.tsc.json --noEmit",
        "clean": "rm -rf ./.astro && rm -rf dist/* && rm -rf node_modules && rm -rf pnpm-lock.yaml && rm -f *.lock && rm -f *.log",
        "dev": "astro dev",
        "format:check": "oxfmt --check . && prettier --check '**/*.astro'",
        "format:fix": "oxfmt --write . && prettier --write '**/*.astro'",
        "lint": "oxlint --type-aware",
        "lint:fix": "oxlint --type-aware --fix",
        "preview": "astro preview",
        "scan": "cve-lite --all --verbose .",
        "start": "astro dev",
        "update": "pnpm update --latest",
        "upgrade": "pnpm dlx @astrojs/upgrade"
    },
    "dependencies": {
        "@astrojs/mdx": "^7.0.3",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "3.7.3",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "^7.1.3",
        "astro-theme-toggle": "^0.8.1",
        "daisyui": "^5.7.0",
        "dayjs": "^1.11.21",
        "globals": "^17.7.0",
        "puppeteer": "^25.3.0",
        "sharp": "^0.35.3",
        "tailwindcss": "^4.3.3",
        "typescript": "npm:@typescript/typescript6@^6.0.2"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.9",
        "@astrojs/ts-plugin": "^1.10.10",
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/typography": "^0.5.20",
        "@typescript-eslint/parser": "^8.65.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "checkcss": "^2.0.9",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^3.0.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "oxfmt": "^0.60.0",
        "oxlint": "^1.75.0",
        "oxlint-tsgolint": "^7.0.2001",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-astro-organize-imports": "^0.4.12",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.1.5"
    },
    "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
