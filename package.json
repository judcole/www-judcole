{
    "name": "jc-portfolio",
    "version": "3.0.0",
    "description": "Jud Cole Personal Portfolio Website",
    "type": "module",
    "scripts": {
        "astro": "astro",
        "build": "astro build",
        "check": "eslint . && astro check && tsc --project tsconfig.tsc.json --noEmit",
        "clean": "rm -rf ./.astro && rm -rf dist/* && rm -rf node_modules && rm -rf pnpm-lock.yaml && rm -f *.lock && rm -f *.log",
        "dev": "astro dev",
        "format:check": "oxfmt --check . && prettier --check '**/*.astro'",
        "format:fix": "oxfmt --write . && prettier --write '**/*.astro'",
        "lint": "oxlint --type-aware",
        "lint:fix": "oxlint --type-aware --fix",
        "preview": "astro preview",
        "scan": "cve-lite --all --verbose .",
        "start": "astro dev",
        "update": "pnpm update --latest",
        "upgrade": "pnpm dlx @astrojs/upgrade"
    },
    "dependencies": {
        "@astrojs/mdx": "^7.0.8",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "3.7.3",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "^7.2.9",
        "astro-theme-toggle": "^0.8.2",
        "daisyui": "^5.7.22",
        "dayjs": "^1.11.23",
        "globals": "^17.11.0",
        "puppeteer": "^25.9.0",
        "sharp": "^0.35.4",
        "tailwindcss": "^4.3.3",
        "typescript": "npm:@typescript/typescript6@^6.0.2"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@astrojs/ts-plugin": "^1.10.11",
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/typography": "^0.5.20",
        "@typescript-eslint/parser": "^8.68.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "checkcss": "^2.0.9",
        "cve-lite-cli": "^1.31.0",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^3.1.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "oxfmt": "^0.65.0",
        "oxlint": "^1.80.0",
        "oxlint-tsgolint": "^7.0.2001",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-astro-organize-imports": "^0.4.13",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.2.2"
    },
    "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
