{
    "name": "jc-portfolio",
    "version": "3.0.0",
    "description": "Jud Cole Personal Portfolio Website",
    "type": "module",
    "scripts": {
        "astro": "astro",
        "build": "astro build",
        "check": "eslint . && astro check && tsc --project tsconfig.json --noEmit",
        "clean": "rm -rf ./.astro && rm -rf dist/* && rm -rf node_modules && rm -rf pnpm-lock.yaml && rm -f *.lock && rm -f *.log",
        "dev": "astro dev",
        "format:check": "oxfmt --check . && prettier --check '**/*.astro'",
        "format:fix": "oxfmt --write . && prettier --write '**/*.astro'",
        "lint": "oxlint --type-aware",
        "lint:fix": "oxlint --type-aware --fix",
        "preview": "astro preview",
        "scan": "cve-lite --all --verbose .",
        "start": "astro dev",
        "update": "pnpm update --latest",
        "upgrade": "pnpm dlx @astrojs/upgrade"
    },
    "dependencies": {
        "@astrojs/mdx": "^5.0.6",
        "@astrojs/rss": "^4.0.18",
        "@astrojs/sitemap": "3.7.2",
        "@tailwindcss/vite": "^4.3.0",
        "astro": "^6.4.2",
        "astro-theme-toggle": "^0.8.1",
        "daisyui": "^5.5.20",
        "dayjs": "^1.11.21",
        "globals": "^17.6.0",
        "puppeteer": "^24.43.1",
        "sharp": "^0.34.5",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.9",
        "@astrojs/ts-plugin": "^1.10.9",
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/typography": "^0.5.19",
        "@typescript-eslint/parser": "^8.60.0",
        "checkcss": "^2.0.9",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^1.7.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "oxfmt": "^0.48.0",
        "oxlint": "^1.67.0",
        "oxlint-tsgolint": "^0.22.1",
        "prettier": "^3.8.3",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-astro-organize-imports": "^0.4.12",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "typescript-eslint": "^8.60.0",
        "vite": "^7.3.3"
    },
    "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
